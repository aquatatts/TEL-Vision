{%- comment -%} TEL v6 · Spec strip: one mono line of facts between hairlines. {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .tel-spec{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:8px 14px;padding:20px var(--tel-gutter);background:var(--tel-bg);border-top:1px solid var(--tel-rule);border-bottom:1px solid var(--tel-rule);font-family:var(--tel-mono);font-size:10.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--tel-gold);text-align:center}
  #shopify-section-{{ section.id }} .tel-spec span{white-space:nowrap}
  #shopify-section-{{ section.id }} .tel-spec .dot{color:var(--tel-mute)}
  @media(min-width:900px){#shopify-section-{{ section.id }} .tel-spec{font-size:11.5px;gap:10px 22px;padding:24px var(--tel-gutter)}}
</style>
<div class="tel-spec" role="list">
  {%- for block in section.blocks -%}
    {%- if block.settings.text != blank -%}
      <span role="listitem" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
      {%- unless forloop.last -%}<span class="dot" aria-hidden="true">·</span>{%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "TEL · Spec strip",
  "tag": "section",
  "class": "shopify-section--tel-spec",
  "max_blocks": 5,
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] },
  "settings": [],
  "blocks": [ { "type": "item", "name": "Fact", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "60 ml × 2" } ] } ],
  "presets": [ { "name": "TEL · Spec strip", "category": "TEL", "blocks": [ { "type": "item", "settings": { "text": "60 ml × 2" } }, { "type": "item", "settings": { "text": "Sealed as a set" } }, { "type": "item", "settings": { "text": "First run of five hundred" } } ] } ]
}
{% endschema %}
