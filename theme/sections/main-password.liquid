{%- comment -%}
  TEL Collection — password gate v3 ("Earned. Not given.")
  Email capture is the primary action; storefront password demoted to a text toggle.
  20 Aug 2026: Meta PageView fallback + `Lead` event added. Without a Lead event Meta has no
  conversion signal from this page and can only ever be optimised for clicks.
  v6 (5 Sep 2026): typography moved onto the theme fonts (Cormorant / EB Garamond / IBM Plex Mono),
  proof line made verifiable, perk two aligned with "one price, no sales".
{%- endcomment -%}

<style>
  .telgate *{box-sizing:border-box;margin:0;padding:0}
  .telgate{--tg-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;--tg-serif:var(--heading-font-family,"Cormorant Garamond",Georgia,serif);--tg-body:var(--text-font-family,"EB Garamond",Georgia,serif);background:#080808;color:#ece7dd;font-family:var(--tg-body);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:40px 20px 56px;-webkit-font-smoothing:antialiased}
  .telgate__inner{width:100%;max-width:430px;text-align:center}
  .telgate__mono{font-family:var(--tg-mono);font-size:30px;letter-spacing:.34em;color:#C9A24B;font-weight:500;text-indent:.34em;line-height:1}
  .telgate__logo{max-width:150px;height:auto;display:block;margin:0 auto}
  .telgate__eyebrow{margin-top:16px;font-family:var(--tg-mono);font-size:10px;letter-spacing:.34em;text-transform:uppercase;color:#9A9285}
  .telgate__hr{width:44px;height:1px;background:#C9A24B;margin:24px auto}
  .telgate__h1{font-family:var(--tg-serif);font-size:40px;line-height:1.06;font-weight:400;color:#F5F0E8;letter-spacing:0}
  .telgate__h1 em{font-style:italic;color:#C9A24B}
  .telgate__lede{margin-top:16px;font-size:17px;line-height:1.6;color:#C9C1B4}
  .telgate__offer{margin-top:26px;border:1px solid rgba(201,162,75,.35);padding:20px 18px;text-align:left}
  .telgate__offer-t{font-family:var(--tg-mono);font-size:9.5px;letter-spacing:.3em;text-transform:uppercase;color:#C9A24B;margin-bottom:12px}
  .telgate__offer ul{list-style:none}
  .telgate__offer li{position:relative;padding-left:20px;font-size:16px;line-height:1.5;color:#ece7dd;margin-bottom:10px}
  .telgate__offer li:last-child{margin-bottom:0}
  .telgate__offer li:before{content:"";position:absolute;left:0;top:9px;width:6px;height:6px;background:#C9A24B;border-radius:50%}
  .telgate__form{margin-top:24px}
  .telgate__field{width:100%;background:#101010;border:1px solid #2E2A24;color:#F5F0E8;font-family:var(--tg-body);font-size:17px;padding:17px 16px;text-align:center;outline:none;border-radius:0;-webkit-appearance:none}
  .telgate__field::placeholder{color:#6F6A63;opacity:1}
  .telgate__field:focus{border-color:#C9A24B}
  .telgate__submit{width:100%;margin-top:10px;background:#C9A24B;color:#080808;border:none;font-family:var(--tg-mono);font-size:11.5px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;padding:18px;cursor:pointer;border-radius:0;-webkit-appearance:none;transition:background .25s}
  .telgate__submit:hover{background:#E3C878}
  .telgate__micro{margin-top:12px;font-family:var(--tg-mono);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:#6F6A63}
  .telgate__banner{padding:14px 16px;font-family:var(--tg-body);font-size:15px;line-height:1.5;margin-bottom:14px}
  .telgate__banner--err{border:1px solid #b5544a;background:#1a1210;color:#e08b80}
  .telgate__done{border:1px solid rgba(201,162,75,.45);background:#15130c;padding:28px 22px;margin-top:24px}
  .telgate__done h2{font-family:var(--tg-serif);font-size:28px;color:#F5F0E8;font-weight:400;margin-bottom:10px}
  .telgate__done p{font-size:16px;line-height:1.6;color:#C9C1B4}
  .telgate__proof{margin-top:30px;padding-top:26px;border-top:1px solid rgba(255,255,255,.08)}
  .telgate__proofline{font-family:var(--tg-mono);font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#C9A24B}
  .telgate__quote{margin-top:18px;font-family:var(--tg-serif);font-size:22px;line-height:1.3;color:#F5F0E8;font-style:italic;text-wrap:balance}
  .telgate__attrib{margin-top:14px;font-family:var(--tg-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#C9A24B}
  .telgate__attrib span{display:block;margin-top:5px;letter-spacing:.14em;color:#9A9285}
  .telgate__pw{margin-top:30px;padding-top:22px;border-top:1px solid rgba(255,255,255,.08)}
  .telgate__pw summary{list-style:none;cursor:pointer;color:#6F6A63;font-family:var(--tg-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;text-decoration:underline;text-underline-offset:4px}
  .telgate__pw summary::-webkit-details-marker{display:none}
  .telgate__pw summary:hover{color:#C9A24B}
  .telgate__pw-inner{margin-top:16px}
  .telgate__pw-inner .telgate__field{font-size:16px;padding:14px}
  .telgate__pw-inner .telgate__submit{background:transparent;color:#9A9285;border:1px solid #2E2A24}
  .telgate__pw-inner .telgate__submit:hover{color:#C9A24B;border-color:#C9A24B;background:transparent}
  .telgate__foot{margin-top:30px;font-family:var(--tg-mono);font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#4d4842}
  .telgate__admin{margin-top:14px;font-family:var(--tg-mono);font-size:9.5px;color:#3a3630}
  .telgate__admin a{color:#4d4842;text-decoration:underline}
  @media (max-width:400px){.telgate__h1{font-size:34px}.telgate{padding:32px 16px 44px}}
</style>

<div class="telgate">
  <div class="telgate__inner">

    {%- if section.settings.logo != blank -%}
      {{- section.settings.logo | image_url: width: 400 | image_tag: class: 'telgate__logo', alt: shop.name, width: section.settings.logo.width, height: section.settings.logo.height -}}
    {%- else -%}
      <div class="telgate__mono">TEL</div>
    {%- endif -%}

    <div class="telgate__eyebrow">{{ section.settings.eyebrow | default: 'Chapter One' }}</div>
    <div class="telgate__hr"></div>

    {%- form 'customer' -%}
      {%- if form.posted_successfully? -%}

        <div class="telgate__done">
          <h2>You&rsquo;re on the list.</h2>
          <p>Earned. Not given. That&rsquo;s how everything here works &mdash; and you&rsquo;ve just earned your place. Check your inbox.</p>
        </div>

        {%- assign gate_signup = true -%}

      {%- else -%}

        <h1 class="telgate__h1">{{ section.settings.heading | default: 'Earned.<br><em>Not given.</em>' }}</h1>

        {%- if shop.password_message != blank -%}
          <p class="telgate__lede">{{ shop.password_message }}</p>
        {%- else -%}
          <p class="telgate__lede">That&rsquo;s how everything here works. The Ritual Duo doesn&rsquo;t open to everyone at once &mdash; it opens to the list first. Five hundred sets in the first run.</p>
        {%- endif -%}

        <div class="telgate__offer">
          <div class="telgate__offer-t">What the list gets</div>
          <ul>
            <li>{{ section.settings.perk_one | default: '24 hours before the doors open to anyone else' }}</li>
            <li>{{ section.settings.perk_two | default: 'First run of five hundred. When they’re gone, Chapter One closes.' }}</li>
          </ul>
        </div>

        <div class="telgate__form">
          {%- if form.errors -%}
            <div class="telgate__banner telgate__banner--err">{{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}</div>
          {%- endif -%}

          <input type="hidden" name="contact[tags]" value="newsletter">
          <input class="telgate__field" id="telgate-email" type="email" name="contact[email]" placeholder="Your email address" autocomplete="email" autocapitalize="off" autocorrect="off" required>
          <button class="telgate__submit" type="submit">{{ section.settings.cta | default: 'Get first access' }}</button>
          <div class="telgate__micro">One email when it opens. Nothing else.</div>
        </div>

      {%- endif -%}
    {%- endform -%}

    {%- comment -%}
      Meta signal for this page. Two jobs:
      1. PageView — only fired if no pixel is already present, so gate traffic still builds a
         retargeting audience even where Shopify's app pixel does not run on the password page.
         If an app pixel IS present it has already fired PageView and we do not double count.
      2. Lead — fired on a successful signup. This is the conversion signal the account has
         never had; without it Meta can only be optimised for clicks.
    {%- endcomment -%}
    <script>
      (function () {
        var PIXEL_ID = {{ section.settings.meta_pixel_id | default: '1917775705566990' | strip | json }};
        var IS_SIGNUP = {% if gate_signup %}true{% else %}false{% endif %};
        var LEAD_PARAMS = { content_name: 'TEL gate - first access', content_category: 'password gate' };
        var done = false;

        function trackLead() {
          if (done || !IS_SIGNUP) { return; }
          try { window.fbq('track', 'Lead', LEAD_PARAMS); done = true; } catch (e) {}
        }

        function loadOwnPixel() {
          if (!PIXEL_ID) { return; }
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
          document,'script','https://connect.facebook.net/en_US/fbevents.js');
          try {
            window.fbq('init', PIXEL_ID);
            window.fbq('track', 'PageView');
          } catch (e) {}
          trackLead();
        }

        var tries = 0;
        (function waitForPixel() {
          if (window.fbq) { trackLead(); return; }
          if (++tries > 20) { loadOwnPixel(); return; }
          setTimeout(waitForPixel, 150);
        })();
      })();
    </script>

    <div class="telgate__proof">
      <div class="telgate__proofline">{{ section.settings.rating_line | default: 'Built in a working studio · Surfers Paradise' }}</div>
      {%- if section.settings.quote != blank -%}
        <p class="telgate__quote">&ldquo;{{ section.settings.quote }}&rdquo;</p>
        <div class="telgate__attrib">
          {{ section.settings.quote_name | default: 'Valerio Ciciarelli' }}
          <span>{{ section.settings.quote_role | default: 'Large-scale realism · Squires Ink, Surfers Paradise' }}</span>
        </div>
      {%- endif -%}
    </div>

    <details class="telgate__pw">
      <summary>Have the password?</summary>
      <div class="telgate__pw-inner">
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}
            <div class="telgate__banner telgate__banner--err">{{ form.errors.messages['form'] }}</div>
          {%- endif -%}
          <input class="telgate__field" type="password" name="password" placeholder="Enter password" required>
          <button class="telgate__submit" type="submit">Enter</button>
        {%- endform -%}
      </div>
    </details>

    <div class="telgate__foot">Look after the art</div>
    <div class="telgate__admin">Store owner? <a href="/admin" target="_blank" rel="noopener">Log in here</a></div>

  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "shopify-section--main-password",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:global.colors.scheme", "default": "scheme-3" },
    { "type": "header", "content": "t:sections.main_password.logo_category" },
    { "type": "image_picker", "id": "logo", "label": "t:sections.main_password.logo", "info": "t:sections.main_password.logo_info" },
    { "type": "range", "id": "logo_max_width", "min": 50, "max": 300, "step": 5, "unit": "px", "label": "t:global.image.width", "default": 140 },
    { "type": "range", "id": "logo_mobile_max_width", "min": 50, "max": 170, "step": 5, "unit": "px", "label": "t:global.image.mobile_width", "default": 100 },
    { "type": "header", "content": "TEL gate copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chapter One" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Earned.<br><em>Not given.</em>" },
    { "type": "text", "id": "perk_one", "label": "Perk 1", "default": "24 hours before the doors open to anyone else" },
    { "type": "text", "id": "perk_two", "label": "Perk 2", "default": "First run of five hundred. When they’re gone, Chapter One closes." },
    { "type": "text", "id": "cta", "label": "Button text", "default": "Get first access" },
    { "type": "text", "id": "rating_line", "label": "Proof line", "info": "Keep it verifiable. Star ratings only once real reviews exist.", "default": "Built in a working studio · Surfers Paradise" },
    { "type": "textarea", "id": "quote", "label": "Proof quote", "info": "Keep TGA-safe: hydrate, condition, protect, appearance. No heal / recovery / antibacterial.", "default": "What I recommend to my clients is formulas that work in hydrating the skin and look after my work long after it leaves the studio — because this is my passion." },
    { "type": "text", "id": "quote_name", "label": "Quote attribution", "default": "Valerio Ciciarelli" },
    { "type": "text", "id": "quote_role", "label": "Quote role", "default": "Large-scale realism · Squires Ink, Surfers Paradise" },
    { "type": "header", "content": "Meta tracking" },
    { "type": "text", "id": "meta_pixel_id", "label": "Meta pixel ID", "default": "1917775705566990", "info": "TEL dataset. Used only as a fallback — if the Facebook & Instagram app pixel is already on the page we use that one and do not double count. Clearing this switches the fallback off." },
    { "type": "header", "content": "t:sections.main_password.background_category" },
    { "type": "image_picker", "id": "background_image", "label": "t:global.image.background_image", "info": "t:sections.main_password.background_image_size_recommendation" }
  ],
  "blocks": [
    { "type": "content", "name": "t:sections.main_password.blocks.content.name", "limit": 1, "settings": [ { "type": "color_scheme", "id": "color_scheme", "label": "t:global.colors.scheme", "default": "scheme-2" }, { "type": "inline_richtext", "id": "title", "label": "t:global.text.heading", "default": "Opening soon" }, { "type": "checkbox", "id": "show_newsletter_form", "label": "t:sections.main_password.blocks.content.show_newsletter_form", "default": true } ] },
    { "type": "social_media", "name": "t:sections.main_password.blocks.social_media.name", "limit": 1, "settings": [ { "type": "color_scheme", "id": "color_scheme", "label": "t:global.colors.scheme", "default": "scheme-2" } ] }
  ],
  "default": { "blocks": [ { "type": "content" }, { "type": "social_media" } ] }
}
{% endschema %}
